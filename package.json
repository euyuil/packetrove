{
  "name": "packetrove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "scripts": {
    "dev:api": "pnpm --filter @packetrove/web build && pnpm --filter @packetrove/worker dev",
    "dev:web": "pnpm --filter @packetrove/web dev",
    "cli": "node packages/cli/dist/cli.js",
    "spec:generate": "tsx scripts/openapi.ts",
    "spec:check": "tsx scripts/openapi.ts --check && redocly lint docs/api/openapi.json",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.scripts.json",
    "test": "pnpm build && vitest run",
    "build": "pnpm spec:check && pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm test",
    "deploy": "pnpm build && pnpm --filter @packetrove/worker run deploy",
    "smoke": "pnpm --filter @packetrove/worker smoke"
  },
  "devDependencies": {
    "@redocly/cli": "2.57.0",
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
