{
  "name": "packetrove",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs --auto",
    "dev:api": "pnpm --filter @packetrove/web build && pnpm --filter @packetrove/worker dev",
    "dev:web": "pnpm --filter @packetrove/web dev",
    "cli": "node packages/cli/dist/cli.js",
    "spec:generate": "tsx scripts/openapi.ts",
    "spec:check": "tsx scripts/openapi.ts --check && redocly lint docs/api/openapi.json",
    "docs:mcp:generate": "tsx scripts/mcp-guide.ts",
    "docs:mcp:check": "tsx scripts/mcp-guide.ts --check",
    "registry:generate": "tsx scripts/mcp-registry.ts",
    "registry:check": "tsx scripts/mcp-registry.ts --check",
    "plugin:check": "tsx scripts/openai-plugin.ts check",
    "plugin:build": "tsx scripts/openai-plugin.ts build",
    "hooks:install": "node scripts/install-hooks.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "commits:check": "node scripts/check-commits.mjs --range HEAD",
    "test:git-checks": "node --test scripts/git-checks.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.scripts.json",
    "test": "pnpm build && vitest run",
    "build": "pnpm plugin:check && pnpm registry:check && pnpm docs:mcp:check && pnpm spec:check && pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm test",
    "deploy": "pnpm build && pnpm --filter @packetrove/worker run deploy && pnpm --filter @packetrove/worker run deploy:website",
    "smoke": "pnpm --filter @packetrove/worker smoke",
    "wait:deployment": "tsx scripts/wait-for-deployment.ts"
  },
  "devDependencies": {
    "@redocly/cli": "2.57.0",
    "@types/node": "24.19.0",
    "@zip.js/zip.js": "2.22.0",
    "ajv": "8.20.0",
    "release-please": "17.6.0",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
