{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "always-update": true,
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "packetrove-cli",
      "package-name": "@packetrove/cli",
      "component": "cli",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "changelog-path": "packages/cli/CHANGELOG.md",
      "pull-request-title-pattern": "chore(cli): release ${version}",
      "extra-files": [
        { "type": "json", "path": "packages/cli/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
