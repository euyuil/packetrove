{
  "name": "@packetrove/worker",
  "version": "0.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:build": "tsx ../../scripts/api-assets.ts",
    "dev": "pnpm assets:build && wrangler dev --local",
    "build": "pnpm assets:build && wrangler deploy --dry-run --outdir dist/api && wrangler deploy --config wrangler.website.jsonc --dry-run --outdir dist/website",
    "deploy": "pnpm assets:build && tsx scripts/feedback-config.ts deploy",
    "feedback:config": "tsx scripts/feedback-config.ts config",
    "deploy:website": "wrangler deploy --config wrangler.website.jsonc",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@packetrove/contracts": "workspace:*",
    "@packetrove/core": "workspace:*",
    "hono": "4.13.12",
    "agents": "0.24.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@packetrove/web": "workspace:*",
    "@cloudflare/vitest-plugin": "1.3.4",
    "@cloudflare/workers-types": "5.20260930.2",
    "wrangler": "4.145.0"
  }
}
