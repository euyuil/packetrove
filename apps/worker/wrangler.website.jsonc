{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "packetrove",
  "main": "src/website.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "packetrove.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "env": {
    "development": {
      "name": "packetrove-development",
      "routes": [{ "pattern": "dev.packetrove.com", "custom_domain": true }]
    },
    "staging": {
      "name": "packetrove-staging",
      "routes": [{ "pattern": "staging.packetrove.com", "custom_domain": true }]
    }
  }
}
