{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "packetrove",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/mcp"]
  }
}
