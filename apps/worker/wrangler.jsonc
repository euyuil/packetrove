{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "packetrove",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "packetrove.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/mcp"]
  }
}
